# ============================================================================
# Smart City Cluj-Napoca — Environment Configuration Template (Year 2026)
# ============================================================================
# Description: Centralized environment ledger template for systemic execution.
# Instructions: Copy this file to '.env' locally and inject your real keys.
# Security Note: NEVER commit the actual populated '.env' file to Git.
# ============================================================================

# Database Persistence Engine Route (Unified Local Storage Target)
# If omitted or left empty, the application layer defaults natively to 'app.db'.
DATABASE_PATH=app.db

# Generative AI Platform (Groq Cloud API Assistant Infrastructure)
# Insert your secure, verified live Groq Cloud API access token below.
GROQ_API_KEY=your_groq_api_key_here

# Operational Operator Security & Authentication Gateways
# Mapped strictly to align with the AuthenticationService session requirements.
PLATFORM_ADMIN_USER=your_secure_admin_username_here

# Provide the exact hexadecimal digest signature required by the main application gateway.
# Note: Ensure the string represents a deterministic cryptographic verification signature.
PLATFORM_ADMIN_PASS=your_secure_password_hash_here
